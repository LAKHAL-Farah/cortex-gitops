# Copy to secrets.env (gitignored) and fill in. Used by scripts/seal-secrets.sh.
# Passwords must be URL-safe (no @ : / ? # %) because DATABASE_URL embeds the DB one.
CORTEX_DB_PASSWORD=
CORTEX_NEO4J_PASSWORD=
CORTEX_API_KEY=
CORTEX_JWT_SECRET=
CORTEX_ADMIN_PASSWORD=
# Optional (feature degrades when empty/removed):
QDRANT_API_KEY=
NVIDIA_API_KEY=
TAVILY_API_KEY=
SMTP_USERNAME=
SMTP_PASSWORD=
