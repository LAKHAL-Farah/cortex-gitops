# k3s ships Traefik (ingress class `traefik`); cert-manager issues the certificate.
# Copy to ingress.yaml, set the host, then add `- ingress.yaml` to resources in
# kustomization.yaml. Start with the STAGING issuer; switch to letsencrypt-prod once
# the staging certificate is Ready (avoids Let's Encrypt rate limits).
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: cortex
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-staging   # then: letsencrypt-prod
spec:
  ingressClassName: traefik
  tls:
    - hosts: [cortex.example.com]    # TODO
      secretName: cortex-tls
  rules:
    - host: cortex.example.com       # TODO
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service: { name: web, port: { number: 3000 } }
