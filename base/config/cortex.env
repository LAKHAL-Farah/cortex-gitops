# Non-secret environment for the API (derived from infra/docker-compose.yml).
# Anything sensitive lives in the `cortex-secrets` Secret instead.

# --- runtime -----------------------------------------------------------------
CORTEX_ENV=production
# adr-0015: remediation execution is OFF until switched on on purpose.
CORTEX_REMEDIATION_EXECUTION=off
CORTEX_REMEDIATION_APPROVAL_TTL_MINUTES=60
CORTEX_ADMIN_USERNAME=admin
CORTEX_JWT_TTL_MINUTES=480
CORTEX_PUBLIC_URL=

# --- graph DB ----------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# --- observability backends (not deployed by this repo) ----------------------
# Point these at your Prometheus/Loki per environment (overlays override them).
PROMETHEUS_URL=http://prometheus:9090/api/v1/query
PROMETHEUS_RANGE_URL=http://prometheus:9090/api/v1/query_range
PROMETHEUS_BASE_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
FORECAST_DATASET_REFRESH_INTERVAL_SECONDS=86400

# --- sandbox-only features, neutralised -------------------------------------
# api would crash at import if CORTEX_ANSIBLE_DIR were unset and infra/ansible
# is not in the image. Point it at a path that does not exist: Ansible-based
# node onboarding is disabled in Kubernetes. (Must not contain "ansible-sandbox".)
CORTEX_ANSIBLE_DIR=/srv/ansible-disabled
# Scratch dir (emptyDir) so node CRUD does not 500 when it rewrites file_sd.
PROMETHEUS_FILE_SD_PATH=/file_sd/nodes.json

# --- runtime-written data (PVC mounted at /data; /app is read-only) ----------
FORECAST_DATASET_PATH=/data/forecast_dataset.csv
FORECAST_MODELS_DIR=/data/models

# --- alert e-mail ------------------------------------------------------------
# SMTP_HOST empty = e-mail disabled. Overlays set the real relay.
ALERT_DEFAULT_RECIPIENT_EMAIL=ops@cortex.local
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=cortex@cortex.local
SMTP_STARTTLS=true
ALERT_EMAIL_SEVERITIES=high,critical
ALERT_ESCALATE_CRITICAL_AFTER_MINUTES=15
ALERT_ESCALATE_HIGH_AFTER_MINUTES=60
ALERT_ESCALATION_RECIPIENT_EMAIL=
ALERT_DISPATCH_INTERVAL_SECONDS=10
ANOMALY_DETECTION_INTERVAL_SECONDS=30

# --- FinOps ------------------------------------------------------------------
FINOPS_MONTHLY_COST_EUR=292
FINOPS_CPU_ALLOCATION_RATIO=4.0
FINOPS_RAM_ALLOCATION_RATIO=1.0
FINOPS_CPU_SHARE_OF_COMPUTE=0.60
FINOPS_POOL_SHARE_COMPUTE=0.50
FINOPS_POOL_SHARE_STORAGE=0.30
FINOPS_POOL_SHARE_PLATFORM=0.20
FINOPS_FLOATING_IP_MONTH_EUR=0
FINOPS_CAPACITY_FROM_PROMETHEUS=true

# --- RAG / LLM (keys are in the Secret) --------------------------------------
# Empty QDRANT_URL = knowledge search/ingest unavailable. Overlays set it.
QDRANT_URL=
QDRANT_COLLECTION=cortex-knowledge
QDRANT_OFFICIAL_DOCS_COLLECTION=cortex-openstack-official-docs
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
KNOWLEDGE_CHAT_MIN_SCORE=0.2
# docs/knowledge is not baked into the image, so /knowledge/ingest has nothing
# to read until it is (see README "Known gaps").
CORTEX_KNOWLEDGE_DIR=/app/docs/knowledge
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_NIM_FAST_MODEL=nvidia/nemotron-3-super-120b-a12b
OPENSTACK_DOCS_MIN_SCORE=0.25
OPENSTACK_DOCS_FETCH_TIMEOUT=15

# --- security collector (docker-compose.security.yml) --------------------------
# Without these the API falls back to sandbox hostnames that do not exist here.
CORTEX_PACKAGE_INVENTORY_URL=http://collector:9110
CORTEX_EBPF_ALERTS_URL=http://collector:9110
CORTEX_KEYSTONE_TOKEN_LOG_URL=http://collector:9110
CORTEX_KEYSTONE_EXPECTED_CIDRS=10.0.1.0/24
CORTEX_EBPF_MAX_ALERTS=50
