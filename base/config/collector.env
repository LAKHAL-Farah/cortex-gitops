# Non-secret environment for the security collector.
# COLLECTOR_FALCO_TOKEN lives in `cortex-secrets`; the SSH key and hosts.ini in `collector-ssh`.
COLLECTOR_INVENTORY=/inventory/hosts.ini
COLLECTOR_SSH_KEY_DIR=/ssh
COLLECTOR_DATA_DIR=/data
COLLECTOR_KEYSTONE_HOST=controller
COLLECTOR_KEYSTONE_LOG_PATH=/var/log/kolla/keystone/keystone-apache-public-access.log
COLLECTOR_KEYSTONE_IGNORE_SOURCE_IPS=
COLLECTOR_KEYSTONE_TOKEN_TTL_SECONDS=3600
COLLECTOR_ALERT_MIN_PRIORITY=warning
COLLECTOR_ALERT_IGNORE_REGEX=
COLLECTOR_ALERT_TTL_SECONDS=86400
COLLECTOR_REFRESH_SECONDS=900
# Trivy runs through docker ON EACH NODE (needs docker + internet there).
# Leave a node out with e.g. COLLECTOR_TRIVY_HOSTS=controller,storage (compute1 runs your VMs).
COLLECTOR_TRIVY_ENABLED=true
COLLECTOR_TRIVY_MIN_SEVERITY=MEDIUM
COLLECTOR_TRIVY_REFRESH_SECONDS=21600
COLLECTOR_TRIVY_HOSTS=controller,storage
CORTEX_KEYSTONE_EXPECTED_CIDRS=10.0.1.0/24   